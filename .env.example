# Server & Database
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
DB_PATH=./data/gateway.sqlite

# Admin Authentication (required to sign in at /admin)
ADMIN_PASSWORD=change-me-strong-password

# Public Branding & Origins
SITE_NAME=APInexGate
SITE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8787/v1
API_ORIGIN=http://localhost:8787
CONTACT_EMAIL=support@example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_DOMAIN=

# Customer Google OAuth (optional — required for "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
